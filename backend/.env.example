NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_PATH=./data/radar.sqlite
CORS_ORIGINS=http://127.0.0.1:5173
TRUST_PROXY_CIDRS=
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Spotify OAuth. Leave blank to run the API without the provider connection.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3333/v1/music/spotify/callback
APP_DEEP_LINK=radar://music-connected
